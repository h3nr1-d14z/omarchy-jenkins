{
  "_class": "hudson.model.Hudson",
  "mode": "NORMAL",
  "quietingDown": false,
  "useCrumbs": true,
  "useSecurity": true,
  "numExecutors": 5,
  "jobs": [
    {
      "_class": "com.cloudbees.hudson.plugins.folder.Folder",
      "name": "ci",
      "jobs": [
        { "name": "checkout-service", "color": "blue" },
        { "name": "unit-tests", "color": "blue" },
        { "name": "package-artifacts", "color": "blue" },
        { "name": "security-scan", "color": "blue" }
      ]
    },
    {
      "_class": "com.cloudbees.hudson.plugins.folder.Folder",
      "name": "deploy",
      "jobs": [
        { "name": "publish-docs", "color": "blue" },
        { "name": "deploy-service", "color": "blue_anime" }
      ]
    },
    {
      "_class": "com.cloudbees.hudson.plugins.folder.Folder",
      "name": "docs",
      "jobs": [
        { "name": "docs-lint", "color": "yellow" }
      ]
    },
    {
      "_class": "com.cloudbees.hudson.plugins.folder.Folder",
      "name": "archive",
      "jobs": []
    },
    { "name": "ui-regression", "color": "blue" }
  ]
}
